<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <Deterministic>true</Deterministic>
        <DeterministicSourcePaths>true</DeterministicSourcePaths>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Nuget Properties. -->
        <PackageId>BlurgText</PackageId>
        <Version>0.1.0$(VersionSuffix)</Version>
        <Authors>Callum McGing</Authors>
        <Description>A platform-independent text layout library</Description>
        <PackageProjectUrl>https://github.com/blurgtext/blurgtext</PackageProjectUrl>
        <RepositoryUrl>https://github.com/blurgtext/blurgtext</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <!-- Package files -->
    <ItemGroup>
        <Content Include="README.md" PackagePath="">
            <Pack>true</Pack>
        </Content>
        <Content Include="icon.png" PackagePath="">
            <Pack>true</Pack>
        </Content>
        <Content Include="..\..\LICENSE.txt" PackagePath="">
            <Link>LICENSE.txt</Link>
            <Pack>true</Pack>
        </Content>
    </ItemGroup>
    <ItemGroup>
      <ProjectReference BuildReference="false" Include="..\BlurgText.Native.linux-x64\BlurgText.Native.linux-x64.csproj" />
      <ProjectReference BuildReference="false" Include="..\BlurgText.Native.win-x64\BlurgText.Native.win-x64.csproj" />
      <ProjectReference BuildReference="false" Include="..\BlurgText.Native.win-x86\BlurgText.Native.win-x86.csproj" />
    </ItemGroup>

</Project>
